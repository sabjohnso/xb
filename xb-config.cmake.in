include(CMakeFindDependencyMacro)
find_dependency(EXPAT)

# When xb was built with RE2 support, downstream consumers of
# xb::library must also be able to resolve it.  Mirror the same
# fallback chain used in cmake/xb_deps.cmake at build time.
set(xb_BUILT_WITH_RE2 @xb_HAVE_RE2@)
if(xb_BUILT_WITH_RE2)
  find_dependency(re2 CONFIG QUIET)
  if(NOT re2_FOUND)
    find_dependency(PkgConfig QUIET)
    if(PkgConfig_FOUND)
      pkg_check_modules(xb_re2_pc IMPORTED_TARGET QUIET re2)
      if(xb_re2_pc_FOUND AND NOT TARGET re2::re2)
        add_library(re2::re2 INTERFACE IMPORTED)
        target_link_libraries(re2::re2 INTERFACE PkgConfig::xb_re2_pc)
      endif()
    endif()
  endif()
endif()

if(NOT TARGET xb::header)
  include("${CMAKE_CURRENT_LIST_DIR}/xb-exports.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/xbGenerateCpp.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/xbAddLibrary.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/xbFetchSchemas.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/xbGenerateTestVectors.cmake")
