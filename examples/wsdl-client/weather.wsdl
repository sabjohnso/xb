<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
             xmlns:xs="http://www.w3.org/2001/XMLSchema"
             xmlns:ws="http://example.com/weather"
             xmlns:tns="http://example.com/weather/service"
             targetNamespace="http://example.com/weather/service"
             name="WeatherService">

  <types>
    <xs:schema targetNamespace="http://example.com/weather"
               elementFormDefault="qualified">
      <xs:complexType name="GetTemperature">
        <xs:sequence>
          <xs:element name="city" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
      <xs:element name="GetTemperature" type="ws:GetTemperature"/>

      <xs:complexType name="GetTemperatureResponse">
        <xs:sequence>
          <xs:element name="temperature" type="xs:double"/>
          <xs:element name="unit" type="xs:string"/>
          <xs:element name="city" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
      <xs:element name="GetTemperatureResponse" type="ws:GetTemperatureResponse"/>
    </xs:schema>
  </types>

  <message name="GetTemperatureRequest">
    <part name="parameters" element="ws:GetTemperature"/>
  </message>
  <message name="GetTemperatureResponse">
    <part name="parameters" element="ws:GetTemperatureResponse"/>
  </message>

  <portType name="WeatherPort">
    <operation name="GetTemperature">
      <input message="tns:GetTemperatureRequest"/>
      <output message="tns:GetTemperatureResponse"/>
    </operation>
  </portType>

  <binding name="WeatherBinding" type="tns:WeatherPort">
    <soap12:binding style="document"
                    transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="GetTemperature">
      <soap12:operation soapAction="http://example.com/weather/GetTemperature"/>
      <input><soap12:body use="literal"/></input>
      <output><soap12:body use="literal"/></output>
    </operation>
  </binding>

  <service name="WeatherService">
    <port name="WeatherPort" binding="tns:WeatherBinding">
      <soap12:address location="http://localhost:8080/"/>
    </port>
  </service>

</definitions>
